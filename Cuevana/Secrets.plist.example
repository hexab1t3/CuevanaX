<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Copia este archivo como Secrets.plist y coloca tu Bearer Token de TMDB -->
    <!-- Secrets.plist está ignorado en git para no exponer tus credenciales -->
    <key>TMDB_BEARER_TOKEN</key>
    <string>TU_TOKEN_BEARER_AQUI</string>
</dict>
</plist>
